generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// =========================
// ENUMS
// =========================
//

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  INTERN
}

//
// =========================
// ROLE
// =========================
//

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

//
// =========================
// USER (Authentication)
// =========================
//

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  isActive Boolean @default(true)

  // One User -> One Employee
  employee Employee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

//
// =========================
// DEPARTMENT
// =========================
//

model Department {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

//
// =========================
// DESIGNATION
// =========================
//

model Designation {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("designations")
}

//
// =========================
// BRANCH
// =========================
//

model Branch {
  id String @id @default(uuid())

  name    String
  city    String
  state   String
  country String

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

//
// =========================
// EMPLOYEE
// =========================
//

model Employee {
  id String @id @default(uuid())

  employeeId String @unique

  firstName String
  lastName  String

  phone String?

  dateOfJoining DateTime?

  employmentType EmploymentType @default(PERMANENT)

  status EmployeeStatus @default(ACTIVE)

  // Authentication
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Department
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  // Designation
  designationId String
  designation   Designation @relation(fields: [designationId], references: [id])

  // Branch
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  // Manager Hierarchy
  reportingManagerId String?

  reportingManager Employee? @relation("ReportingManager", fields: [reportingManagerId], references: [id])

  subordinates Employee[] @relation("ReportingManager")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}
